# ============================================================
# DevNest Academy — Client Environment Variables
# ============================================================

# Backend API URL:
# - If frontend and backend are deployed together on Vercel: keep as /api
# - If backend is deployed separately (e.g. Render, Railway, VPS):
#   set to your full live backend URL:
#   VITE_API_URL=https://your-devnest-api.onrender.com/api
VITE_API_URL=/api
